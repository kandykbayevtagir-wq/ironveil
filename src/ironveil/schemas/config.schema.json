{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironveil.dev/schemas/config/v1",
  "title": "IronVeil configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_size_mb": {"type": "number", "minimum": 0.001, "maximum": 1024},
        "workers": {"type": "integer", "minimum": 1, "maximum": 256},
        "respect_gitignore": {"type": "boolean"},
        "follow_symlinks": {"type": "boolean"},
        "scan_binary": {"type": "boolean"},
        "tracked_only": {"type": "boolean"},
        "all_files": {"type": "boolean"},
        "use_cache": {"type": "boolean"},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "not": {
            "required": ["tracked_only", "all_files"],
            "properties": {
              "tracked_only": {"const": true},
              "all_files": {"const": true}
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "minimum_confidence": {"enum": ["high", "medium", "low"]},
        "fail_on": {
          "type": "array",
          "items": {"enum": ["secret", "sensitive-file", "dependency", "iac", "repository", "scan-error", "file", "error"]}
        },
        "no_fail": {"type": "boolean"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "max_commits": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "online": {"type": "boolean"},
        "timeout_seconds": {"type": "number", "minimum": 0.1, "maximum": 120},
        "retries": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "open_browser": {"type": "boolean"},
        "host": {"const": "127.0.0.1"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "allowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "path", "reason"],
        "properties": {
          "rule": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "expires": {"type": "string", "format": "date"}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "severity", "confidence", "regex", "message", "remediation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "category": {"enum": ["secret", "sensitive-file", "dependency", "iac", "repository", "scan-error"]},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "regex": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "remediation": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    },
    "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
